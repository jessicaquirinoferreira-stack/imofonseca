rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'jonasjessicalove@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidProperty(data) {
      return data.keys().hasAll([
        'id', 'slug', 'title', 'builder', 'category', 'priceLabel', 'priceValue',
        'location', 'highlight', 'description', 'bedrooms', 'parking', 'area',
        'status', 'images', 'watermarked', 'featured'
      ]) &&
      data.keys().hasOnly([
        'id', 'slug', 'title', 'builder', 'category', 'priceLabel', 'priceValue',
        'location', 'highlight', 'description', 'bedrooms', 'parking', 'area',
        'status', 'images', 'watermarked', 'featured'
      ]) &&
      data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 128 && data.slug.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
      data.builder is string && data.builder.size() <= 100 &&
      (data.category == 'Minha Casa Minha Vida' || data.category == 'Alto Padrão') &&
      data.priceLabel is string && data.priceLabel.size() >= 1 && data.priceLabel.size() <= 100 &&
      data.priceValue is number && data.priceValue >= 0 &&
      data.location is string && data.location.size() >= 1 && data.location.size() <= 160 &&
      data.highlight is string && data.highlight.size() >= 1 && data.highlight.size() <= 300 &&
      data.description is string && data.description.size() >= 1 && data.description.size() <= 3000 &&
      data.bedrooms is string && data.bedrooms.size() >= 1 && data.bedrooms.size() <= 40 &&
      data.parking is string && data.parking.size() >= 1 && data.parking.size() <= 40 &&
      data.area is string && data.area.size() >= 1 && data.area.size() <= 40 &&
      (data.status == 'Na Planta' || data.status == 'Em Construção' || data.status == 'Pronto para Morar') &&
      data.images is list && data.images.size() >= 1 && data.images.size() <= 50 && data.images[0] is string && data.images[0].size() <= 2000 &&
      data.watermarked is bool &&
      data.featured is bool;
    }

    function isValidSiteConfig(data) {
      return data.keys().hasAll([
        'whatsapp', 'instagram', 'facebook', 'youtube', 'tiktok', 'address', 'creci', 'email'
      ]) &&
      data.keys().hasOnly([
        'whatsapp', 'instagram', 'facebook', 'youtube', 'tiktok', 'address', 'creci', 'email'
      ]) &&
      data.whatsapp is string && data.whatsapp.size() >= 8 && data.whatsapp.size() <= 30 &&
      data.instagram is string && data.instagram.size() <= 250 &&
      data.facebook is string && data.facebook.size() <= 250 &&
      data.youtube is string && data.youtube.size() <= 250 &&
      data.tiktok is string && data.tiktok.size() <= 250 &&
      data.address is string && data.address.size() >= 1 && data.address.size() <= 300 &&
      data.creci is string && data.creci.size() <= 60 &&
      data.email is string && data.email.size() <= 120;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    match /properties/{propertyId} {
      allow get: if isValidId(propertyId);
      allow list: if resource.data.category == 'Minha Casa Minha Vida' || resource.data.category == 'Alto Padrão';
      allow create: if isAdmin() && isValidId(propertyId) && isValidProperty(incoming()) && incoming().id == propertyId;
      allow update: if isAdmin() && isValidId(propertyId) && isValidProperty(incoming()) && incoming().id == existing().id && (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'slug', 'title', 'builder', 'category', 'priceLabel', 'priceValue',
          'location', 'highlight', 'description', 'bedrooms', 'parking', 'area',
          'status', 'images', 'watermarked', 'featured'
        ])
      );
      allow delete: if isAdmin() && isValidId(propertyId);
    }

    match /settings/{configId} {
      allow get: if isValidId(configId);
      allow list: if false;
      allow create: if isAdmin() && isValidId(configId) && isValidSiteConfig(incoming());
      allow update: if isAdmin() && isValidId(configId) && isValidSiteConfig(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'whatsapp', 'instagram', 'facebook', 'youtube', 'tiktok', 'address', 'creci', 'email'
        ])
      );
      allow delete: if isAdmin() && isValidId(configId);
    }

    match /test/{testId} {
      allow get: if isValidId(testId);
      allow list, create, update, delete: if false;
    }
  }
}
